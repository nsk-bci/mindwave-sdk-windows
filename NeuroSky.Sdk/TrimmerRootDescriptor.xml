<linker>
  <!--
    WinRT BLE GATT callbacks are invoked by the Windows Bluetooth stack via
    internal reflection-like dispatch. Without these roots, the .NET trimmer
    silently removes the handler methods in self-contained / AOT builds,
    causing BLE data to stop arriving with no error — identical to the
    Android R8 symptom documented in consumer-rules.pro.
  -->
  <assembly fullname="NeuroSky.Sdk">

    <!-- BleTransport — preserve GATT characteristic notification handler -->
    <type fullname="NeuroSky.Sdk.BleTransport" preserve="all" />

    <!-- BtClassicTransport — preserve RFCOMM stream reader thread entry -->
    <type fullname="NeuroSky.Sdk.BtClassicTransport" preserve="all" />

    <!-- Parser — preserve all parser logic (called from preserved transports) -->
    <type fullname="NeuroSky.Sdk.ThinkGearParser" preserve="all" />

    <!-- Public API surface — preserve for consumers that reference by name -->
    <type fullname="NeuroSky.Sdk.NeuroSkySdk" preserve="all" />
    <type fullname="NeuroSky.Sdk.BrainWaveData" preserve="all" />
    <type fullname="NeuroSky.Sdk.SignalQuality" preserve="all" />
    <type fullname="NeuroSky.Sdk.ConnectionState" preserve="all" />
    <type fullname="NeuroSky.Sdk.TransportMode" preserve="all" />
    <type fullname="NeuroSky.Sdk.ITransport" preserve="all" />
    <type fullname="NeuroSky.Sdk.NeuroSkyUuid" preserve="all" />
    <type fullname="NeuroSky.Sdk.NeuroSkyCommand" preserve="all" />

  </assembly>
</linker>
