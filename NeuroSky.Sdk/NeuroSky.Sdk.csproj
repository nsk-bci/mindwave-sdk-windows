<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <RootNamespace>NeuroSky.Sdk</RootNamespace>
    <AssemblyName>NeuroSky.Sdk</AssemblyName>

    <!-- NuGet Package Metadata -->
    <PackageId>NeuroSky.MindWave.Sdk</PackageId>
    <Version>2.0.1</Version>
    <Authors>nsk-bci</Authors>
    <Description>Modern C# SDK for NeuroSky MindWave EEG headsets — BLE + BT Classic via WinRT, no TGC dependency</Description>
    <PackageTags>neurosky;mindwave;eeg;bci;ble;bluetooth;sdk</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/nsk-bci/mindwave-sdk-windows</PackageProjectUrl>
    <RepositoryUrl>https://github.com/nsk-bci/mindwave-sdk-windows</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>

    <!-- Trimming support for self-contained / AOT publish.
         Symptom of missing rules: BLE data stops silently in trimmed builds. -->
    <IsTrimmable>true</IsTrimmable>
    <TrimmerRootDescriptor>TrimmerRootDescriptor.xml</TrimmerRootDescriptor>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
