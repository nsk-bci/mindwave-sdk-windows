<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <RootNamespace>NeuroSky.Sdk</RootNamespace>
    <AssemblyName>NeuroSky.Sdk</AssemblyName>
    <Version>2.0.0</Version>
    <Authors>NeuroSky</Authors>
    <Description>Modern Windows SDK for NeuroSky MindWave EEG headsets — BLE + BT Classic via WinRT, no TGC dependency</Description>
    <PackageId>NeuroSky.MindWave.Sdk</PackageId>
  </PropertyGroup>

</Project>
